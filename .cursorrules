## Component Template Rules

### Single Unified Component
Each app has **ONE component** that contains the full app UI with internal navigation. This component is the app's visual shell — it handles all views, routing, and user interactions.

**Platform features** (entities, agents, workflows, data registrations) are managed through Heurisk's UI/API — they are NOT separate components. The component reads/writes data via the runtime bridge but doesn't duplicate platform functionality.

### Empty State Rendering (CRITICAL)
**Your component MUST render immediately, even when no data exists.** Never wait for data to load before showing the UI.

**Correct initialization flow:**
1. Render the static UI structure immediately (topbar, navigation, containers)
2. Show a loading state or empty state while data loads
3. Attempt to load entities and records
4. If data exists, render the data views
5. If no data exists, show a friendly empty state with guidance

**Empty state requirements:**
- Must show the app's branding and navigation structure
- Must explain what the app does and how to get started
- Must not show a blank page or "Failed to load" error
- Must gracefully handle missing `initEntities()` or `apiFetchRecords()` functions

**Example empty state pattern:**
```javascript
document.addEventListener('DOMContentLoaded', async () => {
  // Render empty state immediately
  document.getElementById('app').innerHTML = renderEmptyState();

  try {
    if (typeof initEntities === 'function') {
      entities = await initEntities();
      for (const name of Object.keys(entities)) {
        records[name] = await apiFetchRecords(name);
      }
      
      const hasData = Object.values(records).some(r => r && r.length > 0);
      if (hasData) {
        render(); // Switch to data view
      }
      // Otherwise keep the empty state
    }
  } catch (err) {
    console.error('Failed to initialize:', err);
    // Keep the empty state on error
  }
});

function renderEmptyState() {
  return `
    <div class="topbar"><!-- your app header --></div>
    <div class="content">
      <h1>Welcome to Your App</h1>
      <p>This app is ready to manage your data.</p>
      <p>To get started, add entities and records through the Heurisk platform.</p>
    </div>
  `;
}
```

**Anti-patterns (NEVER DO THESE):**
```javascript
// ❌ WRONG: Waiting for data before rendering anything
document.addEventListener('DOMContentLoaded', async () => {
  entities = await initEntities();
  records = await apiFetchRecords('Fund');
  render(); // Page is blank until this completes
});

// ❌ WRONG: Showing error when no data exists
if (!records.Fund || records.Fund.length === 0) {
  document.getElementById('app').innerHTML = 'Failed to load data';
}

// ❌ WRONG: Not handling missing bridge functions
entities = await initEntities(); // Crashes if initEntities is undefined
```

### Structure
The component is a **single self-contained HTML file** with inline `<style>` and `<script>`. It contains:
- Internal navigation (tabs, sidebar, or top nav)
- Multiple views/screens managed via JavaScript state
- All CSS and JS inline — no external dependencies

### Initialization Pattern
```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .nav { display: flex; gap: 8px; padding: 16px; border-bottom: 1px solid #e5e7eb; }
    .nav-item { padding: 8px 16px; cursor: pointer; border-radius: 6px; }
    .nav-item.active { background: #3b82f6; color: white; }
    .view { display: none; padding: 24px; }
    .view.active { display: block; }
  </style>
</head>
<body>
  <div class="nav">
    <div class="nav-item active" onclick="showView('dashboard')">Dashboard</div>
    <div class="nav-item" onclick="showView('entities')">Entities</div>
    <div class="nav-item" onclick="showView('settings')">Settings</div>
  </div>

  <div id="view-dashboard" class="view active"><!-- Dashboard --></div>
  <div id="view-entities" class="view"><!-- Entities --></div>
  <div id="view-settings" class="view"><!-- Settings --></div>

  <script>
    let entities = {};
    let records = {};
    let currentView = 'dashboard';

    document.addEventListener('DOMContentLoaded', async () => {
      entities = await initEntities();
      for (const name of Object.keys(entities)) {
        records[name] = await apiFetchRecords(name);
      }
      render();
    });

    function showView(viewName) {
      currentView = viewName;
      document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      document.getElementById('view-' + viewName).classList.add('active');
      event.target.classList.add('active');
      render();
    }

    function render() {
      if (currentView === 'dashboard') renderDashboard();
      else if (currentView === 'entities') renderEntities();
      else if (currentView === 'settings') renderSettings();
    }

    function renderDashboard() { /* ... */ }
    function renderEntities() { /* ... */ }
    function renderSettings() { /* ... */ }

    window.onRecordsChanged = async () => {
      for (const name of Object.keys(entities)) {
        records[name] = await apiFetchRecords(name);
      }
      render();
    };
  </script>
</body>

